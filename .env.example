NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

DATABASE_URL="mysql://user:password@host:3306/motormats"
# PEM, or base64(PEM) for hosts whose settings UI mangles newlines.
DATABASE_SSL_CA=""
# Connections per pool. Optional; defaults to 3, which suits a serverless host
# where each warm instance holds its own pool. Raise it on a single Node server.
DATABASE_POOL_SIZE="3"

SESSION_SECRET="replace-with-at-least-32-random-characters"

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

CRON_SECRET="replace-with-random-hex-secret"
